# ---- LLM backend --------------------------------------------------------
# ollama (default, fully local) or groq (hosted, OpenAI-compatible)
LLM_BACKEND=ollama

# Ollama settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Context window. Keep it constant for a whole run: changing it forces Ollama to reload the model.
OLLAMA_NUM_CTX=4096

# Judge model. Use a DIFFERENT model family from the generator to reduce self-preference bias.
# Leave empty to fall back to the generator model (the report will flag this).
JUDGE_MODEL=llama3.2:3b

# Embeddings. ollama (default) uses EMBED_MODEL through Ollama. fastembed runs the same all-MiniLM-L6-v2
# in-process on the CPU (pip install fastembed), for hosting without Ollama. If neither is available,
# hashed bag-of-words vectors are used and a warning is reported.
EMBED_BACKEND=ollama
EMBED_MODEL=all-minilm

# Groq settings (only if LLM_BACKEND=groq). Generator and judge from different model families.
# Reasoning models (openai/gpt-oss-*) automatically get low reasoning effort and extra token headroom.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# Cache LLM responses on disk (.cache/llm.sqlite). Makes re-runs fast and reproducible.
FORGEAI_LLM_CACHE=1

# Web UI only: if set, building an agent in the Factory tab needs this access code (protects a hosted quota)
FACTORY_PASSWORD=
