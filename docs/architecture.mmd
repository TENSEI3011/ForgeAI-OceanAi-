    IDX --> EG
    EG --> V(["Deterministic verification<br/>quotes, facts, leaks, answerability"])
    V -- "drop + regenerate" --> EG
    V --> EV["evals.json<br/>dev / holdout split"]
    DEF --> RUN["Generic runner<br/>retrieve, call tools, answer"]
    EV --> RUN
    RUN --> J["Step 5: Judge<br/>deterministic checks decide,<br/>LLM judge can only veto"]
    J --> C["Step 6: Critic classifies failures<br/>retrieval_miss, prompt_defect,<br/>hallucination, wrong_refusal"]
    C --> O["Targeted fix on dev failures<br/>max 2 categories, leak guard"]
    O --> DEF2["agent_definition_vN.json"]
    DEF2 --> RUN
    J -- "score dropped" --> RB["Roll back"]
    J --> REP["Step 7: Report<br/>scorecard, iteration log,<br/>what still fails and why"]
